      "methods": [
        "card",
        "wallet"
      ]
    },
    "ID": {
      "currency": "IDR",
      "methods": [
        "card",
        "local_method"
      ]
    },
    "SG": {
      "currency": "SGD",
      "methods": [
        "card",
        "wallet",
        "local_method"
      ]
    },
    "HK": {
      "currency": "HKD",
